{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/luckkyboy/chinese-oil-price-data/schema/price-summary.schema.json",
  "title": "Chinese oil price snapshot coverage summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjustment_date",
    "price_file",
    "status",
    "provinces_total",
    "provinces_success",
    "provinces_missing"
  ],
  "properties": {
    "adjustment_date": {
      "type": "string",
      "format": "date"
    },
    "price_file": {
      "type": "string",
      "pattern": "^/data/prices/[0-9]{4}/[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "provinces_total": {
      "type": "integer",
      "minimum": 0
    },
    "provinces_success": {
      "type": "integer",
      "minimum": 0
    },
    "provinces_missing": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{6}$"
      }
    }
  }
}
